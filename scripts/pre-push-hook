#!/bin/sh

RED="\033[91m"
GREEN="\033[92m"
CYAN="\033[96m"
RESET="\033[0m"

echo $CYAN "Running pre-push checks..." $RESET

readme_hash=$(git hash-object README.md)

if ! make ci; then
  echo $RED "Pre-push checks failed. Push aborted. (bypass with 'git push --no-verify')" $RESET
  exit 1
fi

if [ "$(git hash-object README.md)" != "$readme_hash" ]; then
  echo $CYAN "README.md's TUI preview is updated and ready to commit. Push aborted." $RESET
  exit 1
fi

echo $GREEN "All checks passed." $RESET
exit 0
